        <plugin name="Yireo_MspDevToolsFixes::enhancedResponse" type="Yireo\MspDevToolsFixes\Plugin\EnhancedResponsePlugin"/>
    </type>

    <type name="Magento\Framework\App\Response\Http">
        <plugin name="Yireo_MspDevToolsFixes::noCacheWhenInjecting" type="Yireo\MspDevToolsFixes\Plugin\NoCacheWhenInjecting"/>
