<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MSP\DevTools\Model\Config">
        <plugin name="Yireo_MspDevToolsFixes::hardenIsActive" type="Yireo\MspDevToolsFixes\Plugin\HardenIsActive"/>
    </type>

    <type name="MSP\DevTools\Model\CanInjectCode">
        <arguments>
            <argument name="rules" xsi:type="array">
                <item name="jsonRequest" xsi:type="object">Yireo\MspDevToolsFixes\Model\InjectionRules\JsonRequest</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\HTTP\PhpEnvironment\Response">
        <plugin name="mSPDevToolsResponse" disabled="true"/>
    </type>
</config>
